# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- 認証情報の暗号化（利用者のストアAPIキーをDB保存する際に使用）---
# 任意の十分長いランダム文字列。例: openssl rand -base64 48
# 未設定だとストア連携が保存できない（/api/credentials が 501 を返す）。
APP_ENCRYPTION_KEY=

# --- 公開サイト ---
# 法務ページ・料金ページの絶対URL。モバイルの WEB_URL と揃える。
NEXT_PUBLIC_SITE_URL=
# ストア公開後に設定するとランディングに入手ボタンが出る（未設定なら「準備中」表示）。
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Webのダッシュボード画面（/dashboard /inbox /analytics /settings /onboarding）を有効にする。
# RevPilot は iOS / Android アプリとして提供し、Web版は公開しない方針のため、
# 本番では設定しない（未設定＝404）。開発時のデバッグに使う場合のみ true。
ENABLE_WEB_APP=

# --- Cron ---
# GitHub Actions（.github/workflows/poll.yml）と Vercel Cron の両方がこの値を使う。
CRON_SECRET=change-me

# --- 通知 ---
# 利用者への新着レビュー通知・週次サマリーの送信に使用。
RESEND_API_KEY=
# 送信元アドレス（Resendで検証済みドメイン）。未設定なら既定値。
RESEND_FROM=
# 運営（開発者本人）への障害通知の宛先。
# cronが失敗し続けた・時間内に終わらなかった等をここへメールする。
# 未設定だと障害に気づく手段がログを見に行くことだけになる。
OPERATOR_ALERT_EMAIL=

# --- リモートプッシュ通知（Firebase Cloud Messaging）---
# アプリを終了していても新着レビューを端末に届けるために使う。
# Firebase コンソール > プロジェクトの設定 > サービスアカウント で
# 「新しい秘密鍵の生成」を押して得られる JSON の中身を1行で入れる。
# 未設定でも動く（pushだけ送られず、メール/Slack/Discordの通知は従来どおり）。
FIREBASE_SERVICE_ACCOUNT_JSON=

# ===========================================================================
# アプリ内課金（決済はこの2つのみ。Webでの外部決済は提供しない）
# ===========================================================================

# --- iOS: App Store Server API ---
# App Store Connect > ユーザーとアクセス > 統合 > App Store Connect API で
# 「App内課金」用の鍵を発行して設定する。
# 揃うまで /api/billing/iap/apple は 501（穏やかに縮退）。
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# .p8ファイルの中身（改行込み: "-----BEGIN PRIVATE KEY-----\n...")
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=jp.revpilot.app

# --- Sign in with Apple（アカウント削除時のトークン取り消しに使う）---
# developer.apple.com > Keys で「Sign in with Apple」を有効にした鍵を発行して設定する。
# 未設定でもログインはできるが、削除時に Apple 側の連携が残る（審査で指摘されうる）。
APPLE_TEAM_ID=F77Y83KNC7
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
APPLE_SIWA_CLIENT_ID=jp.revpilot.app

# 【開発専用】trueにすると、Apple検証なしでクライアント申告の購入をそのままプランに反映。
# StoreKitローカルテストで“購入→プラン反映”まで無料で一気通貫させるための開発フラグ。
# NODE_ENV=production では常に無効。本番では絶対に true にしないこと。
IAP_DEV_TRUST_CLIENT=

# --- Android: Google Play Developer API ---
# 【重要】これは RevPilot 自身の課金を検証するための“運営専用”サービスアカウント。
# 利用者が登録するレビュー取得用のサービスアカウント（store_credentials）とは別物。
# Play Console > ユーザーと権限 で「財務データ、注文、定期購入の一括レポートを表示」を付与する。
GOOGLE_PLAY_IAP_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=jp.revpilot.app
# リアルタイム開発者通知(RTDN)のURLに付ける共有シークレット。
#   https://<host>/api/billing/iap/google/notifications?secret=<この値>
# 未設定でも動くが、通知エンドポイントが誰でも叩ける状態になるので設定推奨。
GOOGLE_RTDN_SECRET=

# ===========================================================================
# 【現在無効】Stripe（Web決済）
# ===========================================================================
# Web版のダッシュボードを公開しない方針のため、Web からの決済導線は提供していない。
# コードとAPIルートは残してあるが、UIからは呼ばれない。
# 将来Web版を出す場合のみ設定する。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_TEAM=
STRIPE_PORTAL_CONFIGURATION_ID=

# ---------------------------------------------------------------------------
# 【廃止した環境変数】
#
#   ASC_ISSUER_ID / ASC_KEY_ID / ASC_PRIVATE_KEY
#   GOOGLE_SERVICE_ACCOUNT_JSON
#     利用者のストア資格情報は store_credentials へ暗号化保存する。
#     運営の鍵を fallback にすると、利用者が任意の store_app_id を登録するだけで
#     運営の鍵の権限が及ぶ範囲のレビューを読めてしまい、テナント境界が壊れる。
#     本番では絶対に設定しないこと。
#
#   LINE_CHANNEL_ACCESS_TOKEN
#     LINE通知は廃止。運営のBotから push する仕組みだったが、利用者が自分の
#     LINE userId を知る手段が無く、実際には使えない機能だった。
#     通知先は Slack / Discord の Incoming Webhook（設定画面でURLを登録）。
#
#   NOTIFY_EMAIL_TO
#     全利用者の低評価通知がこの1アドレス（運営）に飛ぶ実装だった。
#     通知は当該利用者本人のアドレスへ送るよう修正済み。
#     運営向けの障害通知は OPERATOR_ALERT_EMAIL を使う。
# ---------------------------------------------------------------------------
