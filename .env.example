# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Apple App Store Connect API ---
# Users and Access > Integrations > App Store Connect API
ASC_ISSUER_ID=
ASC_KEY_ID=
# .p8ファイルの中身を改行込みで（"-----BEGIN PRIVATE KEY-----\n...")
ASC_PRIVATE_KEY=

# --- Google Play Developer API ---
# サービスアカウントJSON全体を1行文字列で
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- 認証情報の暗号化（ストアAPIキーをDB保存する際に使用）---
# 任意の十分長いランダム文字列。例: openssl rand -base64 48
APP_ENCRYPTION_KEY=

# --- Cron / 通知 ---
CRON_SECRET=change-me
LINE_CHANNEL_ACCESS_TOKEN=
RESEND_API_KEY=
# 送信元アドレス（Resendで検証済みドメイン）。未設定なら既定値。
RESEND_FROM=
NOTIFY_EMAIL_TO=

# --- Stripe（サブスク課金）---
# 未設定なら課金UIは「未設定」表示で穏やかに縮退する
STRIPE_SECRET_KEY=
# Stripe Dashboard > Developers > Webhooks の署名シークレット（whsec_...）
STRIPE_WEBHOOK_SECRET=
# 各プランの price ID（Stripe Dashboard > Products で作成、price_...）
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_TEAM=
# カスタマーポータルの構成ID（npm run setup:stripe が自動設定。新規アカウント対策）
STRIPE_PORTAL_CONFIGURATION_ID=
# Checkout/ポータルのリダイレクト先の絶対URL（未設定ならリクエスト元originを使用）
NEXT_PUBLIC_SITE_URL=

# --- iOS App内課金(IAP) ---
# 本番のApple購入検証(App Store Server API)に使う鍵。Apple Developer登録後に設定。
# 揃うまで /api/billing/iap/apple は 501（穏やかに縮退）。
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# .p8ファイルの中身（改行込み: "-----BEGIN PRIVATE KEY-----\n...")
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=com.yutatomatsu.revpilot
# 【開発専用】trueにすると、Apple検証なしでクライアント申告の購入をそのままプランに反映。
# StoreKitローカルテストで“購入→プラン反映”まで無料で一気通貫させるための開発フラグ。
# NODE_ENV=production では常に無効。本番では絶対に true にしないこと。
IAP_DEV_TRUST_CLIENT=
