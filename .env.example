# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Apple App Store Connect API ---
# Users and Access > Integrations > App Store Connect API
ASC_ISSUER_ID=
ASC_KEY_ID=
# .p8ファイルの中身を改行込みで（"-----BEGIN PRIVATE KEY-----\n...")
ASC_PRIVATE_KEY=

# --- Google Play Developer API ---
# サービスアカウントJSON全体を1行文字列で
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- 認証情報の暗号化（ストアAPIキーをDB保存する際に使用）---
# 任意の十分長いランダム文字列。例: openssl rand -base64 48
APP_ENCRYPTION_KEY=

# --- Cron / 通知 ---
CRON_SECRET=change-me
LINE_CHANNEL_ACCESS_TOKEN=
RESEND_API_KEY=
# 送信元アドレス（Resendで検証済みドメイン）。未設定なら既定値。
RESEND_FROM=
NOTIFY_EMAIL_TO=

# --- Stripe（サブスク課金）---
# 未設定なら課金UIは「未設定」表示で穏やかに縮退する
STRIPE_SECRET_KEY=
# Stripe Dashboard > Developers > Webhooks の署名シークレット（whsec_...）
STRIPE_WEBHOOK_SECRET=
# 各プランの price ID（Stripe Dashboard > Products で作成、price_...）
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
# Checkout/ポータルのリダイレクト先の絶対URL（未設定ならリクエスト元originを使用）
NEXT_PUBLIC_SITE_URL=
